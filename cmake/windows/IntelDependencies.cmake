# Native Windows SDK configuration. Application build outputs stay in the
# consuming project's build directory; this prefix contains installed SDKs.
set(FEM_WINDOWS_SDK_ROOT "$ENV{FEM_WINDOWS_SDK_ROOT}" CACHE PATH "Native Windows dependency directory")
if(NOT FEM_WINDOWS_SDK_ROOT)
    set(FEM_WINDOWS_SDK_ROOT "E:/Dev/fem" CACHE PATH "Native Windows dependency directory" FORCE)
endif()
file(TO_CMAKE_PATH "${FEM_WINDOWS_SDK_ROOT}" _fem_sdk)
set(_fem_oneapi "${_fem_sdk}/oneapi/Library")
set(FEM_DEPENDENCY_ROOT "${_fem_sdk}/install" CACHE PATH "Installed dependency prefix")
set(CMAKE_PREFIX_PATH "${_fem_sdk}/install/hypre;${_fem_oneapi}" CACHE STRING "Native SDK package prefixes")
set(HYPRE_ROOT "${_fem_sdk}/install/hypre" CACHE PATH "HYPRE prefix")
set(METIS_ROOT "${_fem_sdk}/install/metis" CACHE PATH "METIS prefix")
set(MUMPS_ROOT "${_fem_sdk}/install/mumps" CACHE PATH "MUMPS prefix")
set(MKL_ROOT "${_fem_oneapi}" CACHE PATH "oneMKL prefix")
set(MPI_SKIP_COMPILER_WRAPPER ON CACHE BOOL "Use explicit Intel MPI paths")
set(MPI_SKIP_GUESSING ON CACHE BOOL "Do not choose a different MPI implementation")
set(MPI_CXX_SKIP_MPICXX ON CACHE BOOL "Use the MPI C API from C++")
set(MPIEXEC_EXECUTABLE "${_fem_oneapi}/bin/mpiexec.exe" CACHE FILEPATH "Intel MPI launcher")
foreach(_language IN ITEMS C CXX Fortran)
    set(MPI_${_language}_LIBRARIES "${_fem_oneapi}/lib/impi.lib" CACHE STRING "Intel MPI libraries" FORCE)
    set(MPI_${_language}_LIB_NAMES impi CACHE STRING "Intel MPI library name" FORCE)
    set(MPI_${_language}_ADDITIONAL_INCLUDE_DIRS "${_fem_oneapi}/include" CACHE STRING "Intel MPI headers" FORCE)
endforeach()
set(MPI_impi_LIBRARY "${_fem_oneapi}/lib/impi.lib" CACHE FILEPATH "Intel MPI import library" FORCE)
set(MPI_C_HEADER_DIR "${_fem_oneapi}/include" CACHE PATH "MPI C headers" FORCE)
set(MPI_CXX_HEADER_DIR "${_fem_oneapi}/include" CACHE PATH "MPI C++ headers" FORCE)
set(MPI_Fortran_ADDITIONAL_INCLUDE_DIRS "${_fem_oneapi}/include;${_fem_oneapi}/include/mpi" CACHE STRING "MPI headers/modules" FORCE)
set(CMAKE_Fortran_FLAGS "/MD" CACHE STRING "DLL CRT for Fortran")
set(OpenMP_RUNTIME_MSVC llvm CACHE STRING "LLVM OpenMP with MSVC")
set(OpenMP_CXX_FLAGS "-openmp:llvm" CACHE STRING "MSVC OpenMP C++ flags")
set(OpenMP_C_FLAGS "-openmp:llvm" CACHE STRING "MSVC OpenMP C flags")
set(MKL_MPI_WRAPPER_LIB mkl_blacs_intelmpi_lp64 CACHE STRING "Intel MPI BLACS")
set(BLA_VENDOR Intel10_64lp_seq CACHE STRING "Sequential LP64 oneMKL")
set(ScaLAPACK_LIBRARIES "${_fem_oneapi}/lib/mkl_scalapack_lp64.lib;${_fem_oneapi}/lib/mkl_blacs_intelmpi_lp64.lib" CACHE STRING "ScaLAPACK/BLACS")
