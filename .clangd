# clangd 项目配置
# 参考文档: https://clangd.llvm.org/config

CompileFlags:
  # 与 CMakePresets.json 中当前使用的预设保持一致。
  CompilationDatabase: build/linux-bundled-release
  Add:
    # mpicxx 的隐式头文件路径不会展开到 compile_commands.json 中。
    - -isystem
    - /usr/lib/x86_64-linux-gnu/openmpi/include
    - -isystem
    - /usr/lib/x86_64-linux-gnu/openmpi/include/openmpi
    # MFEM 启用 OpenMP 后会包含 GCC 提供的 omp.h。
    - -isystem
    - /usr/lib/gcc/x86_64-linux-gnu/13/include
    - -DMUPARSER_STATIC
    - -Wno-vla-extension
  Remove:
    # 颜色输出参数对 clangd 无用；通配符同时覆盖 auto/always 等取值。
    - -fdiagnostics-color=*

Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - modernize-*
    Remove:
      - modernize-use-trailing-return-type
      - readability-magic-numbers
      - readability-identifier-length
    # 仅运行已确认快速的检查，降低编辑期间的延迟。
    FastCheckFilter: Strict
  UnusedIncludes: Strict

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true

Hover:
  ShowAKA: true

Completion:
  AllScopes: true

---
# 第三方源码无需建立后台索引，保留应用代码的完整索引能力。
If:
  PathMatch:
    - mfem/.*
    - build/.*/_deps/.*
Index:
  Background: Skip
